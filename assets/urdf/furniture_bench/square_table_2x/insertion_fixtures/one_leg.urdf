    <!-- Inactive holes (3 corners not targeted by the one_leg task). The
         canonical-mesh visual above shows all 4 hole geometries; these
         cylinder collisions add only the cylindrical inner-wall approximation
         to physics. No <visual> tag, so the canonical mesh's carved-out hole
         remains visible (a solid cylinder visual would have *plugged* the
         hole). r ≈ inner thread radius (5 mm); length = table thickness
         (31.25 mm). Active corner is (-0.05625, +0.05687); the other three
         corners are at the mirrored XY positions. -->
    <collision name="hole_inact_0_c"><origin xyz="0.112500 0.113740 0.000000" rpy="0 0 0"/><geometry><cylinder radius="0.010000" length="0.062500"/></geometry></collision>
