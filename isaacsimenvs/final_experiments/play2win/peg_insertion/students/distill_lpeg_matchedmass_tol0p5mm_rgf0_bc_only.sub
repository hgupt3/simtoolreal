#!/bin/bash
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=12
#SBATCH --get-user-env
#SBATCH --mem=300000
#SBATCH -t 24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH -o /dev/null
#SBATCH -e /dev/null

# Pure-BC distillation for Lpeg_matchedmass.tol0p5mm (no PPO term).
#
# Identical to ../distill_lpeg_matchedmass_tol0p5mm_rgf0.sub except
# LAMBDA_D_FLOOR=1.0 -> lambda_D stays pinned at 1.0 forever, the loss is
# pure BC MSE, and the PPO term has 0 weight throughout. As a side effect:
#   - The asymmetric critic never trains (LR scale = 1 - lambda_D = 0 always).
#   - Adaptive LR never engages (lambda_PPO < 0.1 always).
# Use this as the no-PPO control to compare against the PPO+BC paper recipe.

TASK_ID="Isaacsimenvs-PegInHoleDepthStudent-Direct-v0"
AGENT_KEY="rl_games_dagger_ppo_cfg_entry_point"
PROBLEM="Lpeg_matchedmass.tol0p5mm"
GOAL_MODE="preInsertAndFinal"

# Override via env var to point at the new teachers_final run once it lands:
#   TEACHER_RUN_DIR=/share/portal/kk837/depthbasedRL/train_dir/teachers_final/play2win_peg_insertion/lpeg_tol0p5mm_finetune_rgf0_<datetime> sbatch ...
TEACHER_RUN_DIR="${TEACHER_RUN_DIR:-/share/portal/kk837/depthbasedRL/train_dir/teachers_final/play2win_peg_insertion/lpeg_tol0p5mm_finetune_rgf0_2026-05-15_03-38-51}"

# 8x bump from previous 512 envs to close the gap with the paper's 16384.
# Raycaster has no rasterizer/RTX overhead so per-env footprint is just
# (PhysX articulation + 70x70 ray batch + result buffer). Override via env var
# if this OOMs or if you want to push higher:
#   NUM_ENVS=8192 sbatch ...
NUM_ENVS=${NUM_ENVS:-4096}
# Match arXiv:2602.15827 Table VI: minibatch=4096, mini_epochs=2.
# With our 4096 envs * 16 horizon = 65536 samples/iter -> 16 mini-batches/iter.
# Grad steps/iter = 16 * 2 = 32 (paper does 192 from 16384 envs * 24 horizon).
# Bump NUM_ENVS toward 16384 if you want to close that grad-step gap.
MINIBATCH_SIZE=4096
MINI_EPOCHS=2
LR=3e-4
# Match paper Table VI: max 20k iters, curriculum_end = decay_frac * max_iters
# = 10k. Bump to 100k later if 4096 envs (vs paper's 16384) need more grad
# steps to converge.
MAX_ITERATIONS=20000
# Paper: init noise std = 0.01 -> log_sigma_init = log(0.01) = -4.605.
# Default yaml is -1.0 (sigma ~ 0.37), 37x too noisy for a BC bootstrap.
LOG_SIGMA_INIT=-4.605

CRITIC=asymmetric
# DAgger-PPO blend a la arXiv 2602.15827 (Perceptive Humanoid Parkour, Sec.
# III-D / Tab. VI): lambda_D decays 1.0 -> 0.1 over the first half of training,
# and the BC term itself is scaled by distill_coef = 10.0 so the effective BC
# weight at the floor is 0.1 * 10 = 1.0 (same magnitude as the PPO term).
LAMBDA_D_START=1.0
# Pinned at 1.0: pure BC throughout. PPO term has 0 weight; the LAMBDA_D_DECAY
# schedule and DISTILL_COEF still operate but lambda_PPO stays at 0 forever,
# so the asymmetric critic / adaptive LR / KL controls all stay off.
LAMBDA_D_FLOOR=1.0
LAMBDA_D_DECAY_FRAC=0.5
DISTILL_COEF=10.0
# Pure-BC warmup. Pins lambda_D = 1.0 (lambda_PPO = 0) for the first N iters,
# so actor trains BC-only and the lambda_D curriculum begins FROM lambda_D=1.0
# after the warmup (rather than 0.9, as it would if the curriculum ran from
# iter 0). Combined with skip_central_value, this gives a clean post-warmup
# ramp 0 -> 0.9 for the critic instead of a 10% jump at iter 1000.
VALUE_WARMUP_EPOCHS=1000
# Skip rl_games' unconditional central_value_net training during the warmup;
# after the warmup, our train_central_value wrapper scales the optimizer LR
# by (1 - lambda_D) to mirror the paper's L_PPO weight ramp.
SKIP_CENTRAL_VALUE_UNTIL_EPOCH=1000

RANDOM_GOAL_FRACTION=0.0
RANDOM_GOAL_MAX_SUCCESSES=5
GOAL_XY_OBS_NOISE=0.0
INSERTION_SUCCESS_TOLERANCE=0.010
SUCCESS_TOLERANCE=0.01
TARGET_SUCCESS_TOLERANCE=0.01
SUCCESS_STEPS=1

# 0.0 for this run since the teacher checkpoint predates the yaw randomization
# feature. Bump back to 10.0 once we have a teacher trained with hole yaw rand.
HOLE_YAW_RANGE_DEG=10.0

ENABLE_RETRACT=True
RETRACT_REWARD_SCALE=1.0
RETRACT_DISTANCE_THRESHOLD=0.1
RETRACT_SUCCESS_TOLERANCE=0.005

# DR off across the board for the lpeg_final student.
USE_OBS_DELAY=False
OBS_DELAY_MAX=0
USE_ACTION_DELAY=False
ACTION_DELAY_MAX=0
USE_CAMERA_DELAY=False
CAMERA_DELAY_MAX=0
USE_OBJECT_STATE_DELAY_NOISE=False
OBJECT_STATE_XYZ_NOISE_STD=0.0
OBJECT_STATE_ROTATION_NOISE_DEG=0.0
JOINT_VELOCITY_OBS_NOISE_STD=0.0
OBJECT_SCALE_NOISE_RANGE="[1.0,1.0]"

USE_CAMERA_POSE_RAND=False
USE_DEPTH_AUG=False

# Direct 70x70 raycaster: cast rays straight into the policy-input grid,
# no intermediate 160x90 render + crop. Intrinsics keep the real ZED's
# pixel scale (fx=fy=115.67) and principal point (cx=-9.98, cy=47.13).
# CRITICAL: PinholeCameraPatternCfg expects DIMENSIONLESS offsets:
#   offset = (c - n/2) / f_px
#   horizontal_aperture        = 33.197 * 70/160 = 14.524 mm
#   horizontal_aperture_offset = (-9.98 - 35) / 115.67 = -0.389 (dimensionless)
#   vertical_aperture_offset   = ( 47.13 - 35) / 115.67 = +0.105 (dimensionless)
# (Confusingly, the TiledCamera/FS PinholeCameraCfg expects cm here.)
# cx is intentionally outside the image because the real ZED's optical
# axis sits to the left of where the policy 70x70 crop is sampled.
CAMERA_BACKEND=raycaster
IMAGE_WIDTH=70
IMAGE_HEIGHT=70
HORIZONTAL_APERTURE=14.524
HORIZONTAL_APERTURE_OFFSET=-0.389
VERTICAL_APERTURE_OFFSET=0.105

FORCE_SCALE=0.0
TORQUE_SCALE=0.0

RESET_POSITION_NOISE_X=0.1
RESET_POSITION_NOISE_Y=0.1
RESET_POSITION_NOISE_Z=0.02
RESET_DOF_POS_NOISE_ARM=0.1
RESET_DOF_POS_NOISE_FINGERS=0.1
RESET_DOF_VEL_NOISE=0.5
TABLE_RESET_Z_RANGE=0.0

TABLE_RESET_XY_RANGE="[0.0,0.0]"
TABLE_RESET_YAW_RANGE_DEG=0.0
TABLE_SCALE_RANGE_X="[1.0,1.0]"
TABLE_SCALE_RANGE_Y="[1.0,1.0]"
TABLE_SCALE_NUM_VARIANTS=1

LIFTING_REW_SCALE=20.0
LIFTING_BONUS=300.0
FORCE_CONSECUTIVE_NEAR_GOAL=True

CAPTURE_VIEWER_LEN=600
CAPTURE_VIEWER_INTERVAL=6000
CAPTURE_VIEWER_ENV_ID=0
CAPTURE_VIEWER_WANDB_KEY="interactive_viewer"

WANDB_PROJECT="students_final"
WANDB_GROUP="play2win_peg_insertion_distill_bc_only"
EXPERIMENT_TAG="lpeg_matchedmass_tol0p5mm_rgf0_distill_bc_only"

set -euo pipefail
REPO_ROOT="/share/portal/kk837/depthbasedRL"
if [ ! -d "$TEACHER_RUN_DIR" ]; then
    echo "Teacher run dir not found: $TEACHER_RUN_DIR" >&2
    exit 1
fi

DATETIME=$(date +"%Y-%m-%d_%H-%M-%S")
EXPERIMENT_NAME="${EXPERIMENT_TAG}_${DATETIME}"
if [ -n "${SLURM_JOB_ID:-}" ]; then
    scontrol update JobId="$SLURM_JOB_ID" JobName="$EXPERIMENT_NAME" || true
fi
HYDRA_RUN_DIR="${REPO_ROOT}/train_dir/${WANDB_PROJECT}/${WANDB_GROUP}/${EXPERIMENT_NAME}"
mkdir -p "$HYDRA_RUN_DIR"
exec > "${HYDRA_RUN_DIR}/slurm.log" 2> "${HYDRA_RUN_DIR}/slurm.err"

echo "=== Initial GPU State ==="
nvidia-smi
echo ""
echo "Teacher run dir:    $TEACHER_RUN_DIR"
echo "Hydra run dir:      $HYDRA_RUN_DIR"
echo "num_envs:           $NUM_ENVS"
echo "minibatch_size:     $MINIBATCH_SIZE"
echo "mini_epochs:        $MINI_EPOCHS"
echo "learning_rate:      $LR"
echo "critic:             $CRITIC"
echo "problem:            $PROBLEM"
echo "hole_yaw_deg:       $HOLE_YAW_RANGE_DEG"
echo "success_steps:      $SUCCESS_STEPS"
echo ""

GPU_LOG="${HYDRA_RUN_DIR}/gpu_usage.log"
(
    while true; do
        echo "=== $(date '+%Y-%m-%d %H:%M:%S') ===" >> "$GPU_LOG"
        nvidia-smi --query-gpu=memory.used,memory.total,memory.free,utilization.gpu,temperature.gpu \
            --format=csv,noheader >> "$GPU_LOG" 2>&1
        sleep 30
    done
) &
GPU_MONITOR_PID=$!

RAM_LOG="${HYDRA_RUN_DIR}/ram_usage.log"
(
    while true; do
        echo "=== $(date '+%Y-%m-%d %H:%M:%S') ===" >> "$RAM_LOG"
        free -m | head -2 >> "$RAM_LOG" 2>&1
        ps -eo pid,rss,comm --sort=-rss --no-headers 2>/dev/null | head -5 >> "$RAM_LOG"
        if [ -n "${SLURM_JOB_ID:-}" ] && command -v sstat >/dev/null 2>&1; then
            sstat -j "$SLURM_JOB_ID" --format=MaxRSS,AveRSS --noheader 2>/dev/null >> "$RAM_LOG" || true
        fi
        sleep 30
    done
) &
RAM_MONITOR_PID=$!

trap "kill $GPU_MONITOR_PID $RAM_MONITOR_PID 2>/dev/null" EXIT

cd "$REPO_ROOT"
source .venv_isaacsim/bin/activate
export OMNI_KIT_ACCEPT_EULA=YES
export OMNI_KIT_CACHE_PATH="/tmp/${USER}_ov_cache_dagger_${SLURM_JOB_ID:-$$}"
mkdir -p "$OMNI_KIT_CACHE_PATH"

python -u isaacsimenvs/dagger/train.py \
    --task "$TASK_ID" \
    --agent "$AGENT_KEY" \
    --teacher-run-dir "$TEACHER_RUN_DIR" \
    --critic "$CRITIC" \
    --lambda-d-start "$LAMBDA_D_START" \
    --lambda-d-floor "$LAMBDA_D_FLOOR" \
    --lambda-d-decay-frac "$LAMBDA_D_DECAY_FRAC" \
    --distill-coef "$DISTILL_COEF" \
    --value-warmup-epochs "$VALUE_WARMUP_EPOCHS" \
    --skip-central-value-until-epoch "$SKIP_CENTRAL_VALUE_UNTIL_EPOCH" \
    --headless \
    --enable_cameras \
    --capture_viewer \
    --capture_viewer_len "$CAPTURE_VIEWER_LEN" \
    --capture_viewer_interval "$CAPTURE_VIEWER_INTERVAL" \
    --capture_viewer_env_id "$CAPTURE_VIEWER_ENV_ID" \
    --capture_viewer_wandb_key "$CAPTURE_VIEWER_WANDB_KEY" \
    --wandb_activate \
    --wandb_project "$WANDB_PROJECT" \
    --wandb_group "$WANDB_GROUP" \
    --wandb_entity kk837 \
    --wandb_name "$EXPERIMENT_NAME" \
    env.scene.num_envs=$NUM_ENVS \
    env.scene.replicate_physics=False \
    env.scene.clone_in_fabric=False \
    env.peg_in_hole.problem="$PROBLEM" \
    env.peg_in_hole.goal_mode="$GOAL_MODE" \
    env.peg_in_hole.goal_xy_obs_noise=$GOAL_XY_OBS_NOISE \
    env.peg_in_hole.random_goal_fraction=$RANDOM_GOAL_FRACTION \
    env.peg_in_hole.random_goal_max_successes=$RANDOM_GOAL_MAX_SUCCESSES \
    env.peg_in_hole.insertion_success_tolerance=$INSERTION_SUCCESS_TOLERANCE \
    env.peg_in_hole.hole_yaw_range_deg=$HOLE_YAW_RANGE_DEG \
    env.termination.success_tolerance=$SUCCESS_TOLERANCE \
    env.termination.target_success_tolerance=$TARGET_SUCCESS_TOLERANCE \
    env.termination.success_steps=$SUCCESS_STEPS \
    env.peg_in_hole.enable_retract=$ENABLE_RETRACT \
    env.peg_in_hole.retract_reward_scale=$RETRACT_REWARD_SCALE \
    env.peg_in_hole.retract_distance_threshold=$RETRACT_DISTANCE_THRESHOLD \
    env.peg_in_hole.retract_success_tolerance=$RETRACT_SUCCESS_TOLERANCE \
    env.domain_randomization.force_scale=$FORCE_SCALE \
    env.domain_randomization.torque_scale=$TORQUE_SCALE \
    env.domain_randomization.use_obs_delay=$USE_OBS_DELAY \
    env.domain_randomization.obs_delay_max=$OBS_DELAY_MAX \
    env.domain_randomization.use_action_delay=$USE_ACTION_DELAY \
    env.domain_randomization.action_delay_max=$ACTION_DELAY_MAX \
    env.student_obs.use_camera_delay=$USE_CAMERA_DELAY \
    env.student_obs.camera_delay_max=$CAMERA_DELAY_MAX \
    env.student_obs.use_camera_pose_rand=$USE_CAMERA_POSE_RAND \
    env.student_obs.use_depth_aug=$USE_DEPTH_AUG \
    env.student_obs.camera_backend=$CAMERA_BACKEND \
    env.student_obs.image_width=$IMAGE_WIDTH \
    env.student_obs.image_height=$IMAGE_HEIGHT \
    env.student_obs.image_input_width=$IMAGE_WIDTH \
    env.student_obs.image_input_height=$IMAGE_HEIGHT \
    env.student_obs.crop_enabled=False \
    env.student_obs.horizontal_aperture=$HORIZONTAL_APERTURE \
    env.student_obs.horizontal_aperture_offset=$HORIZONTAL_APERTURE_OFFSET \
    env.student_obs.vertical_aperture_offset=$VERTICAL_APERTURE_OFFSET \
    env.domain_randomization.use_object_state_delay_noise=$USE_OBJECT_STATE_DELAY_NOISE \
    env.domain_randomization.object_state_xyz_noise_std=$OBJECT_STATE_XYZ_NOISE_STD \
    env.domain_randomization.object_state_rotation_noise_degrees=$OBJECT_STATE_ROTATION_NOISE_DEG \
    env.domain_randomization.joint_velocity_obs_noise_std=$JOINT_VELOCITY_OBS_NOISE_STD \
    "env.domain_randomization.object_scale_noise_multiplier_range=$OBJECT_SCALE_NOISE_RANGE" \
    env.reset.reset_position_noise_x=$RESET_POSITION_NOISE_X \
    env.reset.reset_position_noise_y=$RESET_POSITION_NOISE_Y \
    env.reset.reset_position_noise_z=$RESET_POSITION_NOISE_Z \
    env.reset.reset_dof_pos_random_interval_arm=$RESET_DOF_POS_NOISE_ARM \
    env.reset.reset_dof_pos_random_interval_fingers=$RESET_DOF_POS_NOISE_FINGERS \
    env.reset.reset_dof_vel_random_interval=$RESET_DOF_VEL_NOISE \
    env.reset.table_reset_z_range=$TABLE_RESET_Z_RANGE \
    "env.reset.table_reset_xy_range_m=$TABLE_RESET_XY_RANGE" \
    env.reset.table_reset_yaw_range_deg=$TABLE_RESET_YAW_RANGE_DEG \
    "env.assets.table_scale_range_x=$TABLE_SCALE_RANGE_X" \
    "env.assets.table_scale_range_y=$TABLE_SCALE_RANGE_Y" \
    env.assets.table_scale_num_variants=$TABLE_SCALE_NUM_VARIANTS \
    env.reward.lifting_rew_scale=$LIFTING_REW_SCALE \
    env.reward.lifting_bonus=$LIFTING_BONUS \
    env.termination.force_consecutive_near_goal_steps=$FORCE_CONSECUTIVE_NEAR_GOAL \
    agent.params.config.minibatch_size=$MINIBATCH_SIZE \
    agent.params.config.central_value_config.minibatch_size=$MINIBATCH_SIZE \
    agent.params.config.normalize_input=False \
    agent.params.config.mini_epochs=$MINI_EPOCHS \
    agent.params.config.learning_rate=$LR \
    agent.params.config.lr_schedule=adaptive \
    agent.params.config.max_epochs=$MAX_ITERATIONS \
    agent.params.network.log_sigma_init=$LOG_SIGMA_INIT \
    hydra.run.dir="$HYDRA_RUN_DIR"
