#!/bin/bash
#SBATCH -N 1
#SBATCH -n 1
#SBATCH --cpus-per-task=12
#SBATCH --get-user-env
#SBATCH --mem=100000
#SBATCH -t 24:00:00
#SBATCH --partition=portal
#SBATCH --exclude=portal-compute-01
#SBATCH --gres=gpu:1
#SBATCH -o /dev/null
#SBATCH -e /dev/null

# RL post-training from the BC-only `distill_baseline.sub` student
# (../camera_noise_ablations/distill_baseline.sub, run dir
#  train_dir/dagger_camera_noise_ablations/bc_only_det/camrand_off_depthaug_off_12h_2026-05-13_14-24-17).
#
# Strategy: same dagger/train.py, same SAPG agent.
#  - First 100 updates (value warmup): loss = mse + 0.5 * critic_coef * c_loss.
#    Actor PPO loss, entropy bonus, bounds penalty are suppressed so the
#    cold-init value head can catch up while the actor only sees BC labels.
#  - Then lambda_D ramps linearly from 1.0 -> 0.0 over the next 50% of the
#    remaining epochs, then pure SAPG for the final ~50%.
#  - env.termination.success_steps=1 so a single near-goal step counts as
#    success (rather than 10 consecutive).
#  - lr_schedule=adaptive: rl_games halves LR when policy KL spikes.
# CRITIC=symmetric (same as the BC-only baseline) so the checkpoint's
# network arch matches exactly and all weights transfer.
#
# First-step variant: obs/object noise OFF, delays ON (matching the
# baseline.sub the student was trained against -- changing the delay
# regime would shift the obs distribution off-policy at the start of RL).
# Keeps reset position / DOF noise on -- that's the exploration variance,
# not the obs noise the student has to learn to robustify against.
#
# Hyperparams: n=512, mb=4096, me=4. lr_schedule=adaptive (rl_games tunes
# LR based on policy KL between snapshots) -- safer than identity now that
# PPO gradients enter the picture after the warmup.
# LR dropped to 1e-4 (4x lower than the 4e-4 BC pretrain) -- standard
# fine-tune reduction so the first PPO updates don't blow up the
# well-fit BC weights.
# Load mode is `weights` (drops Adam state) because the BC-only optimizer
# was tuned to MSE gradients, not PPO.

TASK_ID="Isaacsimenvs-PegInHoleDepthStudent-Direct-v0"
AGENT_KEY="rl_games_dagger_sapg_cfg_entry_point"
PROBLEM="Lpeg.tol0p5mm"
GOAL_MODE="preInsertAndFinal"

TEACHER_RUN_DIR="${TEACHER_RUN_DIR:-/share/portal/kk837/depthbasedRL/train_dir/isaacsimenvs/play2win_peg_insertion/lpeg_tol0p5mm_finetune_rgf0_2026-05-11_16-50-01}"
CHECKPOINT="${CHECKPOINT:-/share/portal/kk837/depthbasedRL/train_dir/dagger_camera_noise_ablations/bc_only_det/camrand_off_depthaug_off_12h_2026-05-13_14-24-17/0_lpeg_tol0p5mm_sapg_dagger/best/model.pth}"

NUM_ENVS=512
EXPL_BLOCK=128
# Noise reduction for SAPG: bigger minibatch (more samples per gradient
# step) + fewer mini_epochs (fewer passes over noisy advantage estimates).
# 512 envs * 16 horizon = 8192 batch -> 4096 minibatch = 2 mb/epoch.
MINIBATCH_SIZE=4096
MINI_EPOCHS=4
LR=1e-4
MAX_EPOCHS=6000

CRITIC=symmetric
LAMBDA_D_START=1.0
LAMBDA_D_FLOOR=0.0
LAMBDA_D_DECAY_FRAC=0.5

RANDOM_GOAL_FRACTION=0.0
RANDOM_GOAL_MAX_SUCCESSES=5
GOAL_XY_OBS_NOISE=0.0
INSERTION_SUCCESS_TOLERANCE=0.010
SUCCESS_TOLERANCE=0.01
TARGET_SUCCESS_TOLERANCE=0.01

ENABLE_RETRACT=True
RETRACT_REWARD_SCALE=1.0
RETRACT_DISTANCE_THRESHOLD=0.1
RETRACT_SUCCESS_TOLERANCE=0.005

# === Delays: ON (matching the baseline.sub the student trained against) ===
USE_OBS_DELAY=True
OBS_DELAY_MAX=3
USE_ACTION_DELAY=True
ACTION_DELAY_MAX=3
USE_CAMERA_DELAY=True
CAMERA_DELAY_MAX=3

# === Obs / object noise: OFF (first-step simplification) ===
USE_OBJECT_STATE_DELAY_NOISE=False
OBJECT_STATE_XYZ_NOISE_STD=0.0
OBJECT_STATE_ROTATION_NOISE_DEG=0.0
JOINT_VELOCITY_OBS_NOISE_STD=0.0
OBJECT_SCALE_NOISE_RANGE="[1.0,1.0]"

USE_CAMERA_POSE_RAND=False
USE_DEPTH_AUG=False

FORCE_SCALE=0.0
TORQUE_SCALE=0.0

# === Reset noise: KEPT (exploration variance, not obs noise) ===
RESET_POSITION_NOISE_X=0.1
RESET_POSITION_NOISE_Y=0.1
RESET_POSITION_NOISE_Z=0.02
RESET_DOF_POS_NOISE_ARM=0.1
RESET_DOF_POS_NOISE_FINGERS=0.1
RESET_DOF_VEL_NOISE=0.5
TABLE_RESET_Z_RANGE=0.01

LIFTING_REW_SCALE=20.0
LIFTING_BONUS=300.0
FORCE_CONSECUTIVE_NEAR_GOAL=True

CAPTURE_VIEWER_LEN=600
CAPTURE_VIEWER_INTERVAL=6000
CAPTURE_VIEWER_ENV_ID=0
CAPTURE_VIEWER_WANDB_KEY="interactive_viewer"

WANDB_PROJECT="dagger_rl_post_training"
WANDB_GROUP="lpeg_tol0p5mm"
EXPERIMENT_TAG="rl_post_from_baseline_succ1_warmup100_adapt_24h"
SUCCESS_STEPS=1
VALUE_WARMUP_EPOCHS=100

set -euo pipefail
REPO_ROOT="/share/portal/kk837/depthbasedRL"
if [ ! -d "$TEACHER_RUN_DIR" ]; then
    echo "Teacher run dir not found: $TEACHER_RUN_DIR" >&2
    exit 1
fi
if [ ! -f "$CHECKPOINT" ]; then
    echo "Student checkpoint not found: $CHECKPOINT" >&2
    exit 1
fi

DATETIME=$(date +"%Y-%m-%d_%H-%M-%S")
EXPERIMENT_NAME="${EXPERIMENT_TAG}_${DATETIME}"
if [ -n "${SLURM_JOB_ID:-}" ]; then
    scontrol update JobId="$SLURM_JOB_ID" JobName="$EXPERIMENT_NAME" || true
fi
HYDRA_RUN_DIR="${REPO_ROOT}/train_dir/${WANDB_PROJECT}/${WANDB_GROUP}/${EXPERIMENT_NAME}"
mkdir -p "$HYDRA_RUN_DIR"
exec > "${HYDRA_RUN_DIR}/slurm.log" 2> "${HYDRA_RUN_DIR}/slurm.err"

echo "=== Initial GPU State ==="
nvidia-smi
echo ""
echo "Teacher run dir:    $TEACHER_RUN_DIR"
echo "BC-only checkpoint: $CHECKPOINT"
echo "Hydra run dir:      $HYDRA_RUN_DIR"
echo "num_envs:           $NUM_ENVS"
echo "expl_block_size:    $EXPL_BLOCK"
echo "minibatch_size:     $MINIBATCH_SIZE"
echo "mini_epochs:        $MINI_EPOCHS"
echo "learning_rate:      $LR"
echo "max_epochs:         $MAX_EPOCHS"
echo "critic:             $CRITIC"
echo "lambda_d:           start=$LAMBDA_D_START floor=$LAMBDA_D_FLOOR decay_frac=$LAMBDA_D_DECAY_FRAC"
echo "obs_delay:          $USE_OBS_DELAY"
echo "action_delay:       $USE_ACTION_DELAY"
echo "camera_delay:       $USE_CAMERA_DELAY"
echo "object_state_noise: $USE_OBJECT_STATE_DELAY_NOISE"
echo "joint_vel_noise:    $JOINT_VELOCITY_OBS_NOISE_STD"
echo "object_scale_range: $OBJECT_SCALE_NOISE_RANGE"
echo ""

GPU_LOG="${HYDRA_RUN_DIR}/gpu_usage.log"
(
    while true; do
        echo "=== $(date '+%Y-%m-%d %H:%M:%S') ===" >> "$GPU_LOG"
        nvidia-smi --query-gpu=memory.used,memory.total,memory.free,utilization.gpu,temperature.gpu \
            --format=csv,noheader >> "$GPU_LOG" 2>&1
        sleep 30
    done
) &
GPU_MONITOR_PID=$!

RAM_LOG="${HYDRA_RUN_DIR}/ram_usage.log"
(
    while true; do
        echo "=== $(date '+%Y-%m-%d %H:%M:%S') ===" >> "$RAM_LOG"
        free -m | head -2 >> "$RAM_LOG" 2>&1
        ps -eo pid,rss,comm --sort=-rss --no-headers 2>/dev/null | head -5 >> "$RAM_LOG"
        if [ -n "${SLURM_JOB_ID:-}" ] && command -v sstat >/dev/null 2>&1; then
            sstat -j "$SLURM_JOB_ID" --format=MaxRSS,AveRSS --noheader 2>/dev/null >> "$RAM_LOG" || true
        fi
        sleep 30
    done
) &
RAM_MONITOR_PID=$!

trap "kill $GPU_MONITOR_PID $RAM_MONITOR_PID 2>/dev/null" EXIT

cd "$REPO_ROOT"
source .venv_isaacsim/bin/activate
export OMNI_KIT_ACCEPT_EULA=YES
export OMNI_KIT_CACHE_PATH="/tmp/${USER}_ov_cache_dagger_${SLURM_JOB_ID:-$$}"
mkdir -p "$OMNI_KIT_CACHE_PATH"

python -u isaacsimenvs/dagger/train.py \
    --task "$TASK_ID" \
    --agent "$AGENT_KEY" \
    --teacher-run-dir "$TEACHER_RUN_DIR" \
    --checkpoint "$CHECKPOINT" \
    --checkpoint_load_mode weights \
    --critic "$CRITIC" \
    --lambda-d-start "$LAMBDA_D_START" \
    --lambda-d-floor "$LAMBDA_D_FLOOR" \
    --lambda-d-decay-frac "$LAMBDA_D_DECAY_FRAC" \
    --value-warmup-epochs "$VALUE_WARMUP_EPOCHS" \
    --deterministic-rollouts \
    --headless \
    --enable_cameras \
    --capture_viewer \
    --capture_viewer_len "$CAPTURE_VIEWER_LEN" \
    --capture_viewer_interval "$CAPTURE_VIEWER_INTERVAL" \
    --capture_viewer_env_id "$CAPTURE_VIEWER_ENV_ID" \
    --capture_viewer_wandb_key "$CAPTURE_VIEWER_WANDB_KEY" \
    --wandb_activate \
    --wandb_project "$WANDB_PROJECT" \
    --wandb_group "$WANDB_GROUP" \
    --wandb_entity kk837 \
    --wandb_name "$EXPERIMENT_NAME" \
    env.scene.num_envs=$NUM_ENVS \
    env.scene.replicate_physics=True \
    env.peg_in_hole.problem="$PROBLEM" \
    env.peg_in_hole.goal_mode="$GOAL_MODE" \
    env.peg_in_hole.goal_xy_obs_noise=$GOAL_XY_OBS_NOISE \
    env.peg_in_hole.random_goal_fraction=$RANDOM_GOAL_FRACTION \
    env.peg_in_hole.random_goal_max_successes=$RANDOM_GOAL_MAX_SUCCESSES \
    env.peg_in_hole.insertion_success_tolerance=$INSERTION_SUCCESS_TOLERANCE \
    env.termination.success_tolerance=$SUCCESS_TOLERANCE \
    env.termination.target_success_tolerance=$TARGET_SUCCESS_TOLERANCE \
    env.peg_in_hole.enable_retract=$ENABLE_RETRACT \
    env.peg_in_hole.retract_reward_scale=$RETRACT_REWARD_SCALE \
    env.peg_in_hole.retract_distance_threshold=$RETRACT_DISTANCE_THRESHOLD \
    env.peg_in_hole.retract_success_tolerance=$RETRACT_SUCCESS_TOLERANCE \
    env.domain_randomization.force_scale=$FORCE_SCALE \
    env.domain_randomization.torque_scale=$TORQUE_SCALE \
    env.domain_randomization.use_obs_delay=$USE_OBS_DELAY \
    env.domain_randomization.obs_delay_max=$OBS_DELAY_MAX \
    env.domain_randomization.use_action_delay=$USE_ACTION_DELAY \
    env.domain_randomization.action_delay_max=$ACTION_DELAY_MAX \
    env.student_obs.use_camera_delay=$USE_CAMERA_DELAY \
    env.student_obs.camera_delay_max=$CAMERA_DELAY_MAX \
    env.student_obs.use_camera_pose_rand=$USE_CAMERA_POSE_RAND \
    env.student_obs.use_depth_aug=$USE_DEPTH_AUG \
    env.domain_randomization.use_object_state_delay_noise=$USE_OBJECT_STATE_DELAY_NOISE \
    env.domain_randomization.object_state_xyz_noise_std=$OBJECT_STATE_XYZ_NOISE_STD \
    env.domain_randomization.object_state_rotation_noise_degrees=$OBJECT_STATE_ROTATION_NOISE_DEG \
    env.domain_randomization.joint_velocity_obs_noise_std=$JOINT_VELOCITY_OBS_NOISE_STD \
    "env.domain_randomization.object_scale_noise_multiplier_range=$OBJECT_SCALE_NOISE_RANGE" \
    env.reset.reset_position_noise_x=$RESET_POSITION_NOISE_X \
    env.reset.reset_position_noise_y=$RESET_POSITION_NOISE_Y \
    env.reset.reset_position_noise_z=$RESET_POSITION_NOISE_Z \
    env.reset.reset_dof_pos_random_interval_arm=$RESET_DOF_POS_NOISE_ARM \
    env.reset.reset_dof_pos_random_interval_fingers=$RESET_DOF_POS_NOISE_FINGERS \
    env.reset.reset_dof_vel_random_interval=$RESET_DOF_VEL_NOISE \
    env.reset.table_reset_z_range=$TABLE_RESET_Z_RANGE \
    env.reward.lifting_rew_scale=$LIFTING_REW_SCALE \
    env.reward.lifting_bonus=$LIFTING_BONUS \
    env.termination.force_consecutive_near_goal_steps=$FORCE_CONSECUTIVE_NEAR_GOAL \
    env.termination.success_steps=$SUCCESS_STEPS \
    agent.params.config.expl_coef_block_size=$EXPL_BLOCK \
    agent.params.config.minibatch_size=$MINIBATCH_SIZE \
    agent.params.config.central_value_config.minibatch_size=$MINIBATCH_SIZE \
    agent.params.config.mini_epochs=$MINI_EPOCHS \
    agent.params.config.learning_rate=$LR \
    agent.params.config.lr_schedule=adaptive \
    agent.params.config.max_epochs=$MAX_EPOCHS \
    hydra.run.dir="$HYDRA_RUN_DIR"
